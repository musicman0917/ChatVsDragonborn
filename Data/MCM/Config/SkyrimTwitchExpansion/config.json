{
  "$schema": "https://mcmhelper.com/schema/v1.json",
  "modName": "SkyrimTwitchExpansion",
  "displayName": "Twitch Expansion",
  "pages": [
    {
      "pageDisplayName": "Chaos Prices",
      "content": [
        {
          "type": "text",
          "text": "Prices apply live — no restart needed. Changes are read by both the SKSE plugin and the TwitchBridge companion app from the shared settings file."
        },
        {
          "type": "slider",
          "id": "chaos_ragdoll_price",
          "text": "Ragdoll Player — Price",
          "help": "Points cost for !buy ragdoll",
          "valueOptions": { "min": 0, "max": 2000, "step": 10, "sourceType": "ModSettingInt" },
          "settingId": "chaos.ragdoll.price"
        },
        {
          "type": "slider",
          "id": "chaos_earthquake_price",
          "text": "Earthquake — Price",
          "valueOptions": { "min": 0, "max": 2000, "step": 10, "sourceType": "ModSettingInt" },
          "settingId": "chaos.earthquake.price"
        },
        {
          "type": "slider",
          "id": "chaos_spawn_dragon_price",
          "text": "Spawn Dragon — Price",
          "valueOptions": { "min": 0, "max": 5000, "step": 50, "sourceType": "ModSettingInt" },
          "settingId": "chaos.spawn_dragon.price"
        },
        {
          "type": "slider",
          "id": "chaos_spawn_chickens_price",
          "text": "Chicken Swarm — Price",
          "valueOptions": { "min": 0, "max": 2000, "step": 10, "sourceType": "ModSettingInt" },
          "settingId": "chaos.spawn_chickens.price"
        },
        {
          "type": "slider",
          "id": "chaos_invert_controls_price",
          "text": "Invert Controls — Price",
          "valueOptions": { "min": 0, "max": 2000, "step": 10, "sourceType": "ModSettingInt" },
          "settingId": "chaos.invert_controls.price"
        },
        {
          "type": "slider",
          "id": "chaos_low_gravity_price",
          "text": "Low Gravity — Price",
          "valueOptions": { "min": 0, "max": 2000, "step": 10, "sourceType": "ModSettingInt" },
          "settingId": "chaos.low_gravity.price"
        }
      ]
    },
    {
      "pageDisplayName": "Timers & Polls",
      "content": [
        {
          "type": "slider",
          "id": "invert_controls_duration",
          "text": "Invert Controls — Duration (seconds)",
          "valueOptions": { "min": 5, "max": 120, "step": 5, "sourceType": "ModSettingInt" },
          "settingId": "chaos.invert_controls.duration_seconds"
        },
        {
          "type": "slider",
          "id": "low_gravity_duration",
          "text": "Low Gravity — Duration (seconds)",
          "valueOptions": { "min": 5, "max": 180, "step": 5, "sourceType": "ModSettingInt" },
          "settingId": "chaos.low_gravity.duration_seconds"
        },
        {
          "type": "slider",
          "id": "poll_interval",
          "text": "Chat Vote — Auto-poll Interval (minutes)",
          "valueOptions": { "min": 0, "max": 60, "step": 1, "sourceType": "ModSettingInt" },
          "settingId": "poll.interval_minutes"
        },
        {
          "type": "slider",
          "id": "poll_duration",
          "text": "Chat Vote — Voting Window (seconds)",
          "valueOptions": { "min": 15, "max": 300, "step": 15, "sourceType": "ModSettingInt" },
          "settingId": "poll.duration_seconds"
        }
      ]
    }
  ]
}
