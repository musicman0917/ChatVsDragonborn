{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Twitch": {
    "Channel": "your_channel_name",
    "BotUsername": "your_bot_account",
    "OAuthToken": "",
    "ClientId": "",
    "ClientSecret": "",
    "_comment": "Prefer `dotnet user-secrets` or environment variables (TwitchBridge__Twitch__OAuthToken, etc.) over committing real credentials here."
  },
  "Points": {
    "LedgerPath": "data/points-ledger.json",
    "EarnRatePerMinute": 10,
    "SubGrant": 500,
    "BitsPerPoint": 1
  },
  "Skyrim": {
    "PipeName": "SkyrimTwitchExpansion",
    "ReconnectDelaySeconds": 5
  },
  "Overlay": {
    "ListenUrl": "http://127.0.0.1:9099",
    "_comment": "127.0.0.1-only by default so the overlay isn't reachable off the streamer's own machine."
  },
  "Poll": {
    "AutoPollIntervalMinutes": 15,
    "VoteWindowSeconds": 60,
    "CandidateCount": 3
  }
}
