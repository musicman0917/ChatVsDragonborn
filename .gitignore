# --- C++ / CMake (SKSEPlugin) -----------------------------------------------
SKSEPlugin/build/
SKSEPlugin/out/
# NOTE: SKSEPlugin/extern/CommonLibSSE-NG is a git submodule (see README.md
# "Building"). Do not ignore it here — an ignored path can't be tracked as a
# submodule gitlink, which breaks `git submodule add`. Its own contents are
# already excluded by being a separate git repo, not by this file.
*.obj
*.ilk
*.pdb

# --- .NET (TwitchBridge) -----------------------------------------------------
TwitchBridge/**/bin/
TwitchBridge/**/obj/
TwitchBridge/TwitchBridge.App/data/
*.user

# --- Built/packaged mod payload ----------------------------------------------
Data/SKSE/Plugins/*.dll
Data/SKSE/Plugins/*.json
Data/Scripts/*.pex

# --- Secrets -------------------------------------------------------------
**/appsettings.*.local.json
.env

# --- Editor / OS ---------------------------------------------------------
.vs/
.vscode/
.idea/
*.suo
.DS_Store
Thumbs.db
